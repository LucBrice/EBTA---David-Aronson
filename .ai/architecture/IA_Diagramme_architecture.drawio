        </mxCell>
        <mxCell id="legend_how_to_read" kind="LEGEND" parent="layer_legend_documentation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#172B4D;strokeWidth=3;fontSize=12;fontFamily=Helvetica;spacing=14;" value="&lt;div style=&quot;text-align:center;font-size:18px&quot;&gt;&lt;b&gt;COMMENT LIRE CE DIAGRAMME&lt;/b&gt;&lt;/div&gt;&lt;table style=&quot;width:100%;font-size:12px&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;width:24%;vertical-align:top;padding:8px&quot;&gt;&lt;b&gt;A — FLUX&lt;/b&gt;&lt;br&gt;&lt;b&gt;→ pleine&lt;/b&gt; : flux / appel / transfert&lt;br&gt;&lt;b&gt;↺ retour&lt;/b&gt; : feedback / correction / re-test&lt;br&gt;&lt;b&gt;→ labellisée&lt;/b&gt; : READ / WRITE / CONTROL / OBSERVE…&lt;br&gt;&lt;i&gt;Les flèches racontent d’abord le processus.&lt;/i&gt;&lt;/td&gt;&lt;td style=&quot;width:24%;vertical-align:top;padding:8px&quot;&gt;&lt;b&gt;B — TYPE DE BRIQUE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6554C0&quot;&gt;&lt;b&gt;Violet&lt;/b&gt;&lt;/font&gt; IA / probabiliste&lt;br&gt;&lt;font color=&quot;#0052CC&quot;&gt;&lt;b&gt;Bleu&lt;/b&gt;&lt;/font&gt; déterministe / mécanique&lt;br&gt;&lt;font color=&quot;#FF8B00&quot;&gt;&lt;b&gt;Orange&lt;/b&gt;&lt;/font&gt; contrôle / sécurité / confinement&lt;br&gt;&lt;font color=&quot;#00875A&quot;&gt;&lt;b&gt;Vert&lt;/b&gt;&lt;/font&gt; preuve / accepté&lt;br&gt;&lt;font color=&quot;#DE350B&quot;&gt;&lt;b&gt;Rouge&lt;/b&gt;&lt;/font&gt; erreur / FAIL / blocage&lt;/td&gt;&lt;td style=&quot;width:30%;vertical-align:top;padding:8px&quot;&gt;&lt;b&gt;C — COUCHE&lt;/b&gt;&lt;br&gt;L01 Recherche · L02 Données&lt;br&gt;L03 Backtest · L04 Validation scientifique&lt;br&gt;L05 Orchestration · L06 Persistance &amp;amp; preuves&lt;br&gt;L07 Interface · L08 Qualité logicielle&lt;br&gt;L09 Infrastructure · L10 Agents IA&lt;br&gt;&lt;b&gt;[Lxx]&lt;/b&gt; = principale ; codes suivants = interactions.&lt;br&gt;Ex. Tool Router &lt;b&gt;[L10 · L05]&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;width:22%;vertical-align:top;padding:8px&quot;&gt;&lt;b&gt;D — ROBUSTESSE&lt;/b&gt;&lt;br&gt;&lt;b&gt;P&lt;/b&gt; Prévention · &lt;b&gt;D&lt;/b&gt; Détection&lt;br&gt;&lt;b&gt;C&lt;/b&gt; Confinement · &lt;b&gt;R&lt;/b&gt; Récupération&lt;br&gt;&lt;b&gt;E&lt;/b&gt; Evidence / preuve&lt;br&gt;Ex. Sandbox &lt;b&gt;[L09 · L10] [C]&lt;/b&gt;&lt;br&gt;Type Checking &lt;b&gt;[L08] [P/D]&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div style=&quot;border-top: 2px solid rgb(179, 186, 197); margin-top: 4px; padding-top: 5px; font-size: 11px; line-height: 1.35;&quot;&gt;&lt;b&gt;E — COULEUR DES CONNEXIONS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4C9AFF&quot;&gt;&lt;b&gt;■ BLEU · FLOW&lt;/b&gt;&lt;/font&gt; Processus principal &amp;nbsp; &lt;font color=&quot;#B39DDB&quot;&gt;&lt;b&gt;■ VIOLET · USE&lt;/b&gt;&lt;/font&gt; Utilisation &amp;nbsp; &lt;font color=&quot;#FFAB00&quot;&gt;&lt;b&gt;■ ORANGE · CONTROL&lt;/b&gt;&lt;/font&gt; Permissions / guardrails &amp;nbsp; &lt;font color=&quot;#57D9A3&quot;&gt;&lt;b&gt;■ VERT · READ / WRITE&lt;/b&gt;&lt;/font&gt; Lecture / persistance / preuve&lt;br&gt;&lt;font color=&quot;#FF4FD8&quot;&gt;&lt;b&gt;■ ROSE / MAGENTA → VALIDATE&lt;/b&gt;&lt;/font&gt; Validation / quality gate &amp;nbsp; &lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;■ NOIR → OBSERVE&lt;/b&gt;&lt;/font&gt; Observabilité / monitoring &amp;nbsp; &lt;font color=&quot;#FF7452&quot;&gt;&lt;b&gt;■ ROUGE · FAIL / FEEDBACK&lt;/b&gt;&lt;/font&gt; Erreur / correction / recovery &amp;nbsp; &lt;font color=&quot;#B7FF3C&quot;&gt;&lt;b&gt;■ VERT LIME → DEPLOY&lt;/b&gt;&lt;/font&gt; Release / déploiement&lt;br&gt;&lt;b&gt;La couleur aide à lire rapidement le graphe. La métadonnée &lt;code&gt;relation_type&lt;/code&gt; reste la source de vérité machine.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Palette optimisée pour le mode sombre :&lt;/b&gt; aucune relation importante ne dépend d’une couleur sombre ou peu contrastée.&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="2900" x="5400" y="30" as="geometry" />
        </mxCell>
